# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Seberapa sering cek pair baru (detik). Default 20.
POLL_INTERVAL_SECONDS=20

# Kategori pair StonkFun yang dianggap "stock". Pisahkan dengan koma.
# Pilihan: xstock, prestock, sunrise, custom, currencies, leverage, backpack
STOCK_CATEGORIES=xstock,prestock

# Hanya kirim notifikasi jika market cap token >= nilai ini (USD). Default 0 (semua).
MIN_MARKET_CAP_USD=0

# Opsional: kirim notifikasi ke channel Telegram (bukan cuma chat personal).
# Isi @namachannel (untuk channel public) atau -100xxxxxxxxxx (channel private).
# Bot HARUS dijadikan admin channel dulu dengan izin "Post Messages".
# Kosongkan kalau tidak ingin pakai channel.
TELEGRAM_CHANNEL_ID=@namachannelkamu
