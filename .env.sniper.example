# ============================================================================
# Sniper Raydium CPMM — salin ke .env lalu isi.
# JANGAN pernah commit file .env yang sudah berisi private key.
# ============================================================================

# --- WALLET (WAJIB) ---------------------------------------------------------
# Base58 (ekspor dari Phantom) ATAU array JSON dari solana-keygen
# ATAU path ke file keypair .json.
# Pakai wallet khusus sniping berisi dana yang siap kamu hilangkan.
PRIVATE_KEY=

# --- RPC (WAJIB untuk kecepatan) --------------------------------------------
# Pisahkan dengan koma. Yang pertama dipakai untuk membaca; SEMUANYA dipakai
# untuk menyiarkan transaksi secara paralel.
RPC_HTTP_URLS=https://mainnet.helius-rpc.com/?api-key=ISI_KUNCIMU
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=ISI_KUNCIMU

# tx   = transactionSubscribe (WebSocket berbasis Geyser: Helius/Triton/QuickNode).
#        Transaksi lengkap ikut terkirim -> tidak perlu RPC susulan. INI JALUR CEPAT.
# logs = logsSubscribe, jalan di RPC mana pun, tapi harus getTransaction dulu
#        (+300-800 ms). Untuk belajar/uji coba saja.
DETECTOR=tx

# --- UKURAN ORDER -----------------------------------------------------------
BUY_SOL_AMOUNT=0.05
SLIPPAGE_BPS=1500          # 15% saat beli
SELL_SLIPPAGE_BPS=2500     # 25% saat jual (keluar lebih penting daripada harga)

# --- BIAYA PRIORITAS --------------------------------------------------------
# Ini penentu utama apakah kamu masuk blok pertama atau tidak.
# Biaya = COMPUTE_UNIT_PRICE x COMPUTE_UNIT_LIMIT / 1e6 lamport.
# 500000 x 120000 / 1e6 = 60000 lamport = 0.00006 SOL per transaksi.
COMPUTE_UNIT_LIMIT=120000
COMPUTE_UNIT_PRICE=500000
SELL_COMPUTE_UNIT_PRICE=200000

# --- JITO (opsional) --------------------------------------------------------
# Bundle Jito melewati antrean mempool publik. Tip terpisah dari priority fee.
JITO_ENABLE=false
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1
JITO_TIP_LAMPORTS=1000000

# --- FILTER KEAMANAN --------------------------------------------------------
QUOTE_MINTS=sol                 # sol, usdc, atau alamat mint apa pun (pisah koma)
MIN_QUOTE_LIQUIDITY_SOL=1.0     # tolak kolam terlalu tipis (gampang di-rug)
MAX_QUOTE_LIQUIDITY_SOL=500
ALLOW_TOKEN_2022=false          # Token-2022 bisa punya transfer fee / transfer hook
CHECK_MINT_AUTHORITY=true       # tolak token yang masih bisa dicetak/dibekukan (+1 RPC)
MAX_OPEN_DELAY_SEC=60           # lewati pool yang open_time-nya masih jauh
BLACKLIST_CREATORS=
BLACKLIST_MINTS=

# --- KELUAR DARI POSISI -----------------------------------------------------
# "kenaikan%:porsi_sisa_yang_dijual%" — dieksekusi berurutan.
TAKE_PROFIT_LADDER=100:50,300:100
STOP_LOSS_PCT=50
TRAILING_STOP_PCT=0             # 0 = mati; mis. 30 = jual kalau turun 30% dari puncak
MAX_HOLD_SECONDS=600
POSITION_POLL_MS=900

# --- BATAS RISIKO -----------------------------------------------------------
MAX_OPEN_POSITIONS=3
MAX_BUYS_PER_MINUTE=6
MAX_TOTAL_SPEND_SOL=1.0

# WAJIB diubah ke false kalau mau benar-benar trading. Default true = simulasi.
DRY_RUN=true

# --- NOTIFIKASI (opsional) --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
